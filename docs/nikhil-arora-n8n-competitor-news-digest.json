      "id": "3949b6fe-9285-4c70-a909-ede99bfbbcf1",
      "name": "Edit Fields1",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        3024,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const CATEGORY_ORDER = [\n  \"Product Launch\", \"Funding\", \"Partnership\", \"Acquisition\",\n  \"Hiring/Leadership\", \"Reviews & Comparisons\", \"Company Update\", \"Other\"\n];\n\nconst normalize = s => (s || \"\").trim().toLowerCase();\nconst categoryMap = Object.fromEntries(CATEGORY_ORDER.map(c => [normalize(c), c]));\n\nconst stories = $input.all().map(item => ({\n  ...item.json.output,\n  competitors: item.json.competitors\n}));\n\nconst grouped = {};\nfor (const story of stories) {\n  const matched = categoryMap[normalize(story.category)] || \"Other\";\n  if (!grouped[matched]) grouped[matched] = [];\n  grouped[matched].push(story);\n}\n\nconst dateStr = $now.toFormat('MMM d');\nlet html = `<h2>Competitor Digest — ${dateStr}</h2>`;\n\nfor (const category of CATEGORY_ORDER) {\n  if (!grouped[category]) continue;\n  html += `<h3>${category}</h3><ul>`;\n  for (const story of grouped[category]) {\n    const names = story.competitors.join(', ');\n    html += `<li><strong>${names}</strong> — ${story.summary} <a href=\"${story.link}\">View</a></li>`;\n  }\n  html += `</ul>`;\n}\n\nreturn [{ json: { html, subject: `Competitor Digest — ${dateStr}` } }];"
      },
